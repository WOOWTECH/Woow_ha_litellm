#!/bin/sh
# woow-name-scan (M4 R01): the Supervisor's Ingress decodes request paths once more, so a credential
# name or model id holding a literal %XX (x%2Fy) is reached as another one (x/y) through the HA
# sidebar, and a DELETE/PATCH can hit the wrong resource. LiteLLM now refuses new names like that
# (400); names stored before are listed here at every start, and while any holds a '%' the Ingress
# nginx refuses path-addressed writes carrying '%' (409, marker below). Rename them through port
# 4000 to lift it. Model names with '/' are the normal provider form (chatgpt/...) and are fine.
# Always exits 0: a failed oneshot would stop the container (S6_BEHAVIOUR_IF_STAGE2_FAILS=2).
export WOOW_STEP=woow-name-scan
. /usr/local/lib/woow-litellm/common.sh
cd /

MARKER=/run/woow/ingress-percent-guard
# One line per name, non-printable characters replaced, at most 80 characters (names are labels).
shown() { tr -c '[:print:]\n' '?' | cut -c1-80 | sed 's/^/    /'; }

creds="$(psql_su -d litellm -c "SELECT credential_name FROM \"LiteLLM_CredentialsTable\" WHERE strpos(credential_name, '%') > 0 OR strpos(credential_name, '/') > 0 ORDER BY 1" 2>/dev/null)" || {
  log "WARNING could not read the credential names; the Ingress write guard stays as it was"
  exit 0
}
models="$(psql_su -d litellm -c "SELECT model_id || '  (model_name: ' || model_name || ')' FROM \"LiteLLM_ProxyModelTable\" WHERE strpos(model_id, '%') > 0 OR strpos(model_id, '/') > 0 OR strpos(model_name, '%') > 0 ORDER BY 1" 2>/dev/null)" || {
  log "WARNING could not read the model ids; the Ingress write guard stays as it was"
  exit 0
}
percent="$(psql_su -d litellm -c "SELECT (SELECT count(*) FROM \"LiteLLM_CredentialsTable\" WHERE strpos(credential_name, '%') > 0) + (SELECT count(*) FROM \"LiteLLM_ProxyModelTable\" WHERE strpos(model_id, '%') > 0)" 2>/dev/null)" || percent=1

if [ -n "$creds" ]; then
  log "WARNING credential names with '%' or '/' (the HA sidebar may address another credential; manage them on port 4000):"
  printf '%s\n' "$creds" | shown >&2
fi
if [ -n "$models" ]; then
  log "WARNING model ids with '%' or '/', or model names with '%' (manage them on port 4000):"
  printf '%s\n' "$models" | shown >&2
fi
if [ "$percent" != "0" ]; then
  : > "$MARKER" && chmod 0644 "$MARKER"
  log "sidebar (Ingress) DELETE/PATCH/PUT with '%' in the path are refused (409) until no name holds '%'"
else
  rm -f "$MARKER"
  if [ -z "$creds" ] && [ -z "$models" ]; then
    log "credential names and model ids checked: all can be managed through the sidebar"
  fi
fi
exit 0
