#!/bin/sh
# finish script of the postgres and litellm longruns (DESIGN §7.1, §7.6):
#   svc-finish <service> <exit code> <signal>      (cwd = the service directory)
# s6 restarts a crashed service by itself; 5 crashes within 5 minutes stop the whole container
# with a non-zero exit code, so the Supervisor marks the add-on as failed instead of leaving a
# half-up add-on (nginx up, "starting…" forever). A deliberate stop (s6-rc down, container stop)
# is not counted.
#
# Stopping the container needs both of these (notes/m1-crashloop-fix.md):
#   halt      asks s6-linux-init-shutdownd to shut down; its stage 3 (rc.shutdown) is
#             `s6-rc -bda change`, which first waits for the s6-rc lock;
#   exit 125  permanent failure for s6-supervise: the service is not started again (like
#             `s6-svc -O`), and its 'O' event makes an `s6-rc change` that still waits for this
#             service to become ready fail at once. That is stage 2 when the crash loop starts
#             before the first readiness (S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0: no time limit); it
#             holds the s6-rc lock, so without the 125 the shutdown waits for the lock forever while
#             s6 keeps restarting the service. With S6_BEHAVIOUR_IF_STAGE2_FAILS=2 stage 2 then
#             halts too and writes its own non-zero exit code (s6-rc's) over ours.
name="${1:?service name}"
code="${2:-0}"
sig="${3:-0}"
if [ "$(/command/s6-svstat -o wantedup . 2>/dev/null)" != "true" ]; then
  exit 0
fi
dir=/run/woow/failures
mkdir -p "$dir"
now="$(date +%s)"
f="$dir/$name"
{ [ -f "$f" ] && cat "$f"; echo "$now"; } | awk -v now="$now" '(now - $1) < 300' > "$f.new"
mv "$f.new" "$f"
n="$(wc -l < "$f" | tr -d ' ')"
if [ "$code" = 256 ]; then what="killed by signal $sig"; else what="exited with code $code"; fi
echo "[woow-litellm] $name: $what ($n failure(s) within 5 minutes)" >&2
if [ "$n" -ge 5 ]; then
  echo "[woow-litellm] $name: FATAL failed 5 times within 5 minutes; stopping the add-on (see the messages above)" >&2
  rc=1
  if [ "$code" -gt 0 ] 2>/dev/null && [ "$code" -lt 256 ]; then rc="$code"; fi
  echo "$rc" > /run/s6-linux-init-container-results/exitcode
  /run/s6/basedir/bin/halt || echo "[woow-litellm] $name: WARNING the stop request to s6 failed" >&2
  exit 125
fi
exit 0
