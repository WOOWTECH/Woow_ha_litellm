# Woow LiteLLM add-on: the fallback sidebar page (DESIGN v3.2 §8.2), used only for a start where
# no valid ingress_entry was obtained (no Supervisor token, Supervisor silent for 60 s, or a value
# that failed validation). Restarting the add-on brings the LiteLLM admin UI back.
server {
    listen 8099 default_server;
    server_name _;
    allow 172.30.32.2;
    deny all;

    absolute_redirect off;
    root /run/woow/help;
    index index.html;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store" always;

    location = /status {
        proxy_pass http://127.0.0.1:4000/health/readiness;
        proxy_set_header X-Forwarded-For "";
        proxy_intercept_errors off;
        error_page 502 = @starting;
    }

    location @starting {
        default_type application/json;
        return 200 '{"status":"starting"}';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
