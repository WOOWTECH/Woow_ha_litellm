# Woow LiteLLM add-on: HA sidebar (Ingress) → LiteLLM admin UI (DESIGN v3.2 §8.3).
# Rendered at boot by init-woow-supervisor; @INGRESS_ENTRY@ is the Supervisor's ingress_entry,
# validated against ^/api/hassio_ingress/[A-Za-z0-9_-]{16,128}$ — never taken from a request header.

# HA embeds the UI at the same origin. On this private Ingress port only, rewrite
# DENY and the standalone default CSP policy frame-ancestors 'none'. nginx joins
# multiple upstream CSP headers with commas; preserve every other policy/directive
# (including object/base/nonce restrictions). Explicit compound policies remain
# unchanged, even when they forbid framing; plugin SAMEORIGIN / 'self' also survives.
map $upstream_http_x_frame_options $woow_frame_options {
    default    $upstream_http_x_frame_options;
    "~*^deny$" "SAMEORIGIN";
}
map $upstream_http_content_security_policy $woow_csp {
    default                  $upstream_http_content_security_policy;
    "frame-ancestors 'none'" "frame-ancestors 'self'";
    "~^(?<woow_csp_before>(?:[^,]*,)*[[:blank:]]*)frame-ancestors 'none'(?<woow_csp_after>[[:blank:]]*(?:,.*)?)$" "${woow_csp_before}frame-ancestors 'self'${woow_csp_after}";
}
map $http_upgrade $woow_connection {
    default upgrade;
    ""      "";
}
# Writes addressed by a path that carries a percent escape (DELETE/PATCH/PUT /credentials/<name>,
# PATCH /model/<id>/update). See the guard in the server block.
map "$request_method $request_uri" $woow_write_with_percent {
    default                          0;
    "~^(?:DELETE|PATCH|PUT) [^?]*%"  1;
}

server {
    listen 8099 default_server;
    server_name _;

    # Only the Supervisor's Ingress proxy may connect. Checked on the connection address: realip
    # (below) rewrites $remote_addr to the browser's, so allow/deny would see the wrong address.
    if ($realip_remote_addr != "172.30.32.2") {
        return 403;
    }
    # Browser address: HA Core appends the browser to X-Forwarded-For, the Supervisor appends Core.
    set_real_ip_from 172.30.32.1;
    set_real_ip_from 172.30.32.2;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # nginx's own 502 means "LiteLLM is starting" only until LiteLLM has answered once:
    # /run/woow/litellm.ready is written by woow-spendlogs-indexes when /health/liveliness answers
    # and removed by the litellm finish script. Any later 502 (an upstream answer nginx cannot
    # relay, a dropped connection) is a JSON error, never the auto-reloading "starting" page.
    set $woow_upstream_502 @starting;
    if (-f /run/woow/litellm.ready) {
        set $woow_upstream_502 @upstream_error;
    }
    # The Supervisor's Ingress decodes the request path once more, so a name holding a literal
    # %XX (x%2Fy, x%20y) reaches another resource (x/y, x y), and one holding '#' or '?' (sent as
    # %23, %3F) is cut there (x#y reaches x). While such names exist (marker written at every
    # start by woow-name-scan), path-addressed writes carrying '%' are refused with 409: use
    # LiteLLM's port 4000 directly for them. Without the marker nothing changes.
    set $woow_encoded_write 0;
    if (-f /run/woow/ingress-percent-guard) {
        set $woow_encoded_write $woow_write_with_percent;
    }
    if ($woow_encoded_write = 1) {
        rewrite ^ /.woow/encoded-write last;
    }

    absolute_redirect off;
    client_max_body_size 64m;

    location = / {
        return 302 ui/;
    }

    location / {
        # The Supervisor strips the prefix; LiteLLM (SERVER_ROOT_PATH = the same prefix) serves /ui
        # and /_next only WITH it, so it is put back. $request_uri is forwarded as received (no
        # decode/re-encode: names with %2F or %20 stay intact).
        proxy_pass http://127.0.0.1:4000@INGRESS_ENTRY@$request_uri;
        proxy_http_version 1.1;
        # The browser's Host and the X-Forwarded-Proto / X-Ingress-Path sent by HA pass through
        # unchanged: the login redirect, the cookie's Secure flag and the plugin's URLs use them.
        proxy_set_header Host $http_host;
        # Only the browser address (realip), never a chain the browser could have started.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $woow_connection;
        # Server-set cookies (Path=/) stay under this add-on's prefix.
        proxy_cookie_path ~^/$ @INGRESS_ENTRY@/;
        # Absolute redirects: drop scheme and host, keep the (already prefixed) path. Never
        # `proxy_redirect default`: with a prefixed proxy_pass it would strip the prefix too.
        proxy_redirect ~^https?://[^/]+(/.*)$ $1;
        proxy_buffering off;
        proxy_request_buffering off;
        # The response header must fit proxy_buffer_size even with buffering off; the 4k/8k default
        # turned large upstream headers into nginx 502s while LiteLLM had already answered (and billed).
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_intercept_errors off;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header X-Frame-Options $woow_frame_options always;
        add_header Content-Security-Policy $woow_csp always;
        # Only nginx's own 502 is handled here (LiteLLM's own 502/503/504 answers pass unchanged,
        # proxy_intercept_errors off): "starting" page before LiteLLM is ready, JSON error after.
        error_page 502 = $woow_upstream_502;
    }

    location @upstream_error {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 502 '{"error":{"message":"The Ingress proxy of this add-on could not relay the LiteLLM answer (response header too large or connection lost). LiteLLM may have completed the request: check the logs before retrying. Ingress 無法轉送 LiteLLM 的回應（回應標頭過大或連線中斷）；LiteLLM 可能已完成這個請求，重試前請先查看紀錄。","type":"ingress_proxy_error","param":null,"code":"502"}}';
    }

    location = /.woow/encoded-write {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 409 '{"error":{"message":"This path contains a percent escape and a credential name or model id with a literal %, # or ? exists: the Home Assistant sidebar (Ingress) decodes paths once more and could change or delete another resource. Use LiteLLM directly on port 4000 for this change (or rename that resource there first). 路徑含百分比編碼，且目前有名稱含「%」、「#」或「?」的憑證或模型 ID：Home Assistant 側邊欄（Ingress）會再解碼一次路徑，可能改到或刪到別的資源。請改用 LiteLLM 的 4000 埠直接操作（或先在那裡改名）。","type":"ingress_encoded_path","param":null,"code":"409"}}';
    }

    location @starting {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'self'" always;
        return 503 '<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta http-equiv="refresh" content="10"><title>LiteLLM 啟動中</title><style>body{font-family:system-ui,sans-serif;margin:3rem;color:#333}</style></head><body><h1>LiteLLM 啟動中…</h1><p>第一次啟動或升級後要套用資料庫 migration，可能需要幾分鐘。本頁每 10 秒自動重新整理。</p><p>LiteLLM is starting (database migrations on the first start can take a few minutes). This page reloads every 10 seconds.</p></body></html>';
    }
}
